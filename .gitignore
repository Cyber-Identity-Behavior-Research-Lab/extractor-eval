# Third-party model repos (each is its own git clone; the commit is recorded in its notebook's model card)
models/

# Test clips, manifest, and ground truth stay out of git (folder kept via .gitkeep)
data/*
!data/.gitkeep

# Model outputs stay out of git (folder kept via .gitkeep)
outputs/*
!outputs/.gitkeep

# Model weights
*.pth
*.pt
*.pkl
*.ckpt
*.onnx
*.bin
*.tar

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# uv virtualenvs (envs/<model>/pyproject.toml and uv.lock are tracked)
.venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
